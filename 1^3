import math
A=(2,2)
B=(4,6)
C=(11,6)
D=(9,2)
def vector(p1, p2):
    return (p2[0] - p1[0], p2[1] - p1[1])
def length(v):
    return math.sqrt(v[0]**2 + v[1]**2)
def area_parallelogram(v1, v2):
    return abs(v1[0]*v2[1] - v1[1]*v2[0])
AB=vector(A, B)
AD=vector(A, D)
area=area_parallelogram(AB, AD)
AC=vector(A, C)
BD=vector(B, D)
d1=length(AC)
d2=length(BD)
print(f"Площа паралелограма: {round(area,3)}")
print(f"Довжина діагоналі AC: {round(d1,3)}")
print(f"Довжина діагоналі BD: {round(d2,3)}")
